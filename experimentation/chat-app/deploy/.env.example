# Optional. Copy to .env (git-ignored); compose reads it automatically.
# Everything below has a working default, so you can run without a .env file.

# Folder where Ollama keeps its models. Default: <home>/.ollama/models, where
# <home> comes from %USERPROFILE% on Windows or $HOME on Linux/macOS.
# Set it only if your models live somewhere else (use a full path).
# OLLAMA_MODELS_DIR=D:/ollama/models

# Models downloaded when missing (space separated Ollama names).
# PULL_MODELS=gemma4:e4b-it-qat qwen3.5:4b

# Models kept loaded at once (VRAM is tight).
# LLAMA_MODELS_MAX=1

# The one published port: the gateway serves the app and the API.
# GATEWAY_PORT=3200
