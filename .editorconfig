root = true

[*]
charset = utf-8
insert_final_newline = true
indent_style = space

[*.md]
# Never hard-wrap prose: one paragraph = one line (see tools/unwrap-md.mjs).
max_line_length = off
trim_trailing_whitespace = false

[*.{js,jsx,mjs,json,yaml,yml,css,html}]
indent_size = 2

[*.py]
indent_size = 4

[*.sh]
end_of_line = lf
