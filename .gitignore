# ----- Lockfiles -------------------------------------------------------------
# Lockfiles ARE committed for apps (package-lock.json, pnpm-lock.yaml,
# yarn.lock, uv.lock, poetry.lock, Cargo.lock, go.sum, Gemfile.lock,
# composer.lock). Nothing to ignore here on purpose.

# ----- Project specifics -----------------------------------------------------
# Legacy Alpine version kept for reference
# (remove this line to track it)
# experimentation/chat-app/frontend/legacy/

# Models llama.cpp downloads from Hugging Face on first load (several GB). Never committed,
# and `node execute.mjs prune` leaves this folder alone.
/experimentation/chat-app/models/cache/

# Python venv at the repo root
/.venv/

# Generated by `node execute.mjs up`, never committed. These are also caught by the generic
# secrets/ and logs/ rules above; they are repeated here so the intent is explicit.
# Secrets: the OpenObserve login and the llama.cpp API key (Docker secrets, random values).
/experimentation/chat-app/secrets/
# Logs: cli.log and main.log from tiny-agent, plus OpenObserve's data folder (can hold any
# text the containers printed, so it must never be committed).
/experimentation/chat-app/logs/
# Local settings for the stack (ports, models folder); experimentation/.env.example is the template.
/experimentation/.env

# Build and test output of the chat app
/experimentation/chat-app/frontend/dist/
/experimentation/chat-app/frontend/test-results/
/experimentation/chat-app/frontend/playwright-report/
/tiny_agent.egg-info/
