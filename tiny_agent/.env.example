# Settings for the Python code (tiny-agent, main.py and the model client).
# Copy this file to .env (git-ignored) and fill in only what you need.
# A value set in the real environment always wins over this file.
# Everything is optional: with an empty .env the defaults below apply.

# The model to chat with. Default: whichever model is loaded on the server.
# TINYAGENT_MODEL=gemma4-e4b

# The API root of the model server, ending in /v1. Default: the Docker gateway.
# Ollama would be http://localhost:11434/v1
# TINYAGENT_LLM_URL=http://127.0.0.1:3200/v1

# A system message that sets the model's role (use \n for a new line).
# TINYAGENT_SYSTEM=Be brief.

# Let the model think before it answers (slower). 1, true, yes or on turn it on.
# TINYAGENT_THINK=0

# For a hosted server that needs a key. The Docker stack does not: its backend holds
# the key. Prefer the file form so the key is not in this file; the file holds just the key.
# TINYAGENT_API_KEY_FILE=C:/path/to/api_key
# TINYAGENT_API_KEY=

# Give the main.py demo's agent a memory that keeps only the last two turns (a sliding window), so a long
# conversation stays within the model's context window. 1, true, yes or on turn it on. Default: keep everything.
# TINYAGENT_TRIM_MEMORY=0

# Give the main.py demo's agent a memory that replaces the conversation with a running summary written by the
# model (one extra model call per task). 1, true, yes or on turn it on; it wins over TINYAGENT_TRIM_MEMORY.
# Default: keep everything.
# TINYAGENT_SUMMARY_MEMORY=0

# Give the main.py demo's agent a memory that retrieves the most relevant documents for each question with an
# embedding model and puts them in front of it. 1, true, yes or on turn it on; it wins over the two above.
# Needs the llama-embed container of deploy/llm-client (node execute.mjs up llm-client).
# TINYAGENT_RAG_MEMORY=0
# The embedding model it uses and where it is served. Default: embeddinggemma-300m at http://127.0.0.1:3201/v1.
# TINYAGENT_EMBEDDING_MODEL=
# TINYAGENT_EMBEDDING_URL=

# Give the main.py demo's agent a MemoryBank: a model-written summary of every turn and a user portrait are
# kept, and the summaries a question recalls are put in front of it; unused summaries fade over time. 1, true,
# yes or on turn it on; it wins over all the flags above and uses the same embedding model.
# TINYAGENT_BANK_MEMORY=0

# Where tiny-agent and main.py write cli.log and main.log, and how much they log
# (DEBUG, INFO, WARNING or ERROR). Default: experimentation/chat-app/logs, INFO.
# TINYAGENT_LOG_DIR=
# TINYAGENT_LOG_LEVEL=INFO

# Bind the built-in tools (multiply) to the main.py demo's agent, told to the model in its prompt as JSON to write.
# 1, true, yes or on turn it on. Default: no tools.
# TINYAGENT_TOOLS=0
# Bind them for a model that learned tool calling in training: the definitions go in the request's tools field and
# the prompt holds no tool text. It wins over TINYAGENT_TOOLS.
# TINYAGENT_NATIVE_TOOLS=0
