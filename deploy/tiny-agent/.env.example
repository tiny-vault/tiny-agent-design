# Optional. Copy to .env (git-ignored); compose reads it automatically.
# Everything below has a working default, so you can run without a .env file.

# The model server to chat with. Default: the chat app's gateway on this machine (port from GATEWAY_PORT).
# Any OpenAI-compatible server works, for example Ollama:
# TINYAGENT_LLM_URL=http://host.docker.internal:11434/v1

# The chat app's gateway port, used only when TINYAGENT_LLM_URL is not set.
# GATEWAY_PORT=3200
