# Optional. Copy to .env (git-ignored); compose reads it automatically.
# Everything below has a working default, so you can run without a .env file.

# The port the model server is published on (this machine only). 3200 is what the scripts in
# experimentation/illustrated_agents expect, and the chat app's gateway uses it too: run this folder
# OR the chat app, not both. 3000, 8000, 8080 and 3001 belong to other projects.
# LLAMA_PORT=3200

# The address that port is published on. 127.0.0.1 is this machine only. On Linux, containers (the tiny agent)
# cannot reach a loopback-only port; use 0.0.0.0 there and keep the machine behind a firewall, because this
# server has no API key.
# LLAMA_BIND=127.0.0.1

# Where the downloaded models are kept. Default: ./models/cache in this folder (git-ignored), so the first
# use of a model downloads it. To reuse the chat app's existing downloads instead:
# MODELS_CACHE=../../experimentation/chat-app/models/cache

# The port the embedding server (llama-embed, EmbeddingGemma on the CPU) is published on, same address as above.
# EMBED_PORT=3201

# Models kept loaded at once (6 GB of VRAM holds one).
# LLAMA_MODELS_MAX=1

# The model server the client asks. Default: this folder's own llama service. Point it at another server,
# for example the chat app's gateway, or Ollama:
# TINYAGENT_LLM_URL=http://host.docker.internal:3200/v1
# TINYAGENT_LLM_URL=http://host.docker.internal:11434/v1
