# nginx in front of OpenObserve that logs the browser in automatically (see auto-login.sh).
# ${OO_AUTH_COOKIE} is filled in by nginx's entrypoint from the environment; the other $names
# are nginx variables and are left alone.

map $http_upgrade $connection_upgrade {
  default upgrade;
  ""      close;
}

server {
  listen 80;
  client_max_body_size 50m;

  # Redirects must stay relative: inside the container nginx listens on 80, but the browser
  # reaches it on the published port (5080). An absolute Location would drop that port.
  absolute_redirect off;

  # Docker's DNS, so this can start before OpenObserve and survive its restarts.
  resolver 127.0.0.11 valid=10s;
  set $upstream http://openobserve:5080;

  # Sets the login cookie, then the page sets the browser-side state and opens the UI.
  location = /auto-login {
    root /usr/share/nginx/html;
    try_files /auto-login.html =404;
    default_type text/html;
    add_header Set-Cookie "auth_tokens=${OO_AUTH_COOKIE}; Path=/; HttpOnly; SameSite=Lax; Max-Age=2592000" always;
    add_header Cache-Control "no-store" always;
  }

  # Anyone who lands on the login page or the root goes straight through instead.
  location = / { return 302 /auto-login; }
  location = /web/login { return 302 /auto-login; }

  # The UI itself. If the browser has no login state (cleared storage, signed out), a tiny
  # script injected before the app starts sends it through /auto-login first.
  location /web/ {
    proxy_pass $upstream;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header Accept-Encoding "";   # sub_filter cannot edit compressed responses
    sub_filter_once on;
    sub_filter "<head>" "<head><script>if(!localStorage.getItem('userInfo')){location.replace('/auto-login')}</script>";
  }

  # The API, health check and everything else, passed straight through.
  location / {
    proxy_pass $upstream;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection $connection_upgrade;
    proxy_read_timeout 300s;
  }
}
